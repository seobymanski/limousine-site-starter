---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CTA from '../../components/CTA.astro';
import SectionDivider from '../../components/SectionDivider.astro';
import LocalBusinessSchema from '../../components/schemas/LocalBusinessSchema.astro';
import BreadcrumbSchema from '../../components/schemas/BreadcrumbSchema.astro';
import { fetchBlogPostsByCategory } from '../../lib/payload';

export const prerender = false;

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'News', href: '/news/' },
];

const posts = await fetchBlogPostsByCategory('news', 50).catch(() => []);
---

<BaseLayout
  title="News and Announcements · [BRAND] Aviation"
  description="Company news, partnership announcements, and milestones from [BRAND], official luxury chauffeured partner of the strategic partnership."
>
  <LocalBusinessSchema slot="head" />
  <BreadcrumbSchema slot="head" items={breadcrumbs} />

  <Hero
    variant="page"
    eyebrow="News"
    heading="Announcements and"
    headingItalic="company milestones."
    subheading="Press, partnerships, and operational milestones from [BRAND]."
  />

  <Breadcrumb items={breadcrumbs} />

  <SectionDivider variant="hairline" />

  <section class="bg-[var(--color-ivory)] py-20 lg:py-28">
    <div class="mx-auto max-w-[1100px] px-6 lg:px-12">
      {posts.length === 0 ? (
        <div class="border border-neutral-900/10 p-16 text-center">
          <p class="font-display text-2xl text-neutral-700">No news posted yet.</p>
        </div>
      ) : (
        <div class="space-y-px bg-neutral-900/10">
          {posts.map((post) => (
            <a href={`/news/${post.slug}/`} class="group bg-[var(--color-ivory)] p-8 lg:p-10 flex flex-col md:flex-row md:items-center gap-6 transition-colors duration-300 hover:bg-white">
              <p class="text-xs uppercase tracking-[0.14em] text-neutral-500 md:w-32 shrink-0">
                {new Date(post.publishedDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
              </p>
              <div class="flex-1">
                <h2 class="font-display text-2xl tracking-tight text-neutral-900 group-hover:text-neutral-700 transition-colors">
                  {post.title}
                </h2>
                <p class="mt-2 text-sm text-neutral-600">{post.excerpt}</p>
              </div>
              <svg width="20" height="10" viewBox="0 0 20 10" fill="none" class="shrink-0 transition-transform duration-500 group-hover:translate-x-1.5">
                <path d="M1 5H19M19 5L15 1M19 5L15 9" stroke="currentColor" stroke-width="1" />
              </svg>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>

  <CTA variant="dark" eyebrow="Press" heading="Media inquiries." description="Reach press@example.com for media requests, partnership announcements, and interview availability." />
</BaseLayout>
