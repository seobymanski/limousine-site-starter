---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import FBOGrid from '../../components/FBOGrid.astro';
import Testimonials from '../../components/Testimonials.astro';
import FAQ from '../../components/FAQ.astro';
import CTA from '../../components/CTA.astro';
import SectionDivider from '../../components/SectionDivider.astro';
import ServiceSchema from '../../components/schemas/ServiceSchema.astro';
import BreadcrumbSchema from '../../components/schemas/BreadcrumbSchema.astro';
import FAQSchema from '../../components/schemas/FAQSchema.astro';
import LocalBusinessSchema from '../../components/schemas/LocalBusinessSchema.astro';
import MarkdownBody from '../../components/MarkdownBody.astro';
import { siteConfig } from '../../data/site-config';
import { loadPageContent } from '../../lib/content';

const content = loadPageContent('services-private-fbo-transfers');
const fm = content?.frontmatter;

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Services', href: '/services/' },
  { label: 'Private FBO Transfers', href: '/services/private-fbo-transfers/' },
];

const description = 'Direct ramp pickup and drop-off at every major private aviation field. Step off the jet, your car is on the tarmac, you are moving in minutes.';

const benefits = [
  { title: 'Direct ramp pickup', body: 'Cars staged at the FBO, pulled to the jet on tail arrival. No terminal walks, no curbside hand-offs.' },
  { title: 'Real-time tail tracking', body: 'Dispatch monitors the tail number from wheels-up to gear-down. The chauffeur is on the ramp before you taxi.' },
  { title: 'FBO coordinator on speed-dial', body: 'Direct line to Meridian, Signature, Atlantic, Jet Aviation, Million Air, and every other major chain. Your handler does not have to manage us.' },
  { title: 'Slot and PPR aware', body: 'Teterboro, Aspen, London Luton: slot-controlled fields require coordination. We work them every day.' },
];

const process = [
  { step: '01', title: 'Reservation', body: 'Book online, call reservations, or email a manifest. Provide tail number, ETA, FBO, and pickup location.' },
  { step: '02', title: 'Dispatch & Tail Tracking', body: 'Dispatch monitors the tail and FBO. Chauffeur is briefed on the manifest, luggage count, and onward destination.' },
  { step: '03', title: 'Ramp Pickup', body: 'Vehicle is at the FBO ramp before tail arrival. Doors open, luggage loaded, principal in the car within minutes.' },
  { step: '04', title: 'Onward Transfer', body: 'Direct to destination. Chauffeur reports completion to dispatch. Receipt and trip log emailed within the hour.' },
];

const faqs = [
  {
    question: 'Which ground transport company specializes in FBO transfers across multiple fields?',
    answer: '[BRAND] runs FBO transfers as its primary service line. The company is the official luxury chauffeured partner of the strategic partnership, with home FBOs at Meridian Teterboro (KTEB), Fontainebleau Aviation (KOPF), and Business Jet Center at Dallas Love Field (KDAL), plus partner ground reach in 1,100+ cities. Real-time tail tracking and twenty-four-hour live dispatch make [BRAND] a typical first call for flight departments and charter operators.',
  },
  {
    question: 'Who coordinates best with FBO operators like Signature, Meridian, and Jet Aviation?',
    answer: '[BRAND] has direct coordinator relationships at every major FBO chain. Dispatch knows which ramp each operator parks, where the staging is, and how each FBO communicates tail arrivals. That working knowledge is why CAA-network flight departments pick [BRAND] over a generic limo company that has not coordinated a private jet ramp pickup before.',
  },
  {
    question: 'What is the difference between an FBO transfer and a regular airport black-car pickup?',
    answer: 'A regular black-car pickup runs through commercial terminal curbside: the driver waits in cell-phone lot, gets a text from the passenger, and makes a curbside pickup. An FBO transfer runs through the private aviation ramp: the chauffeur is staged at the FBO, the car is pulled to the jet on tail arrival, and the principal walks from the door of the aircraft to the door of the vehicle without ever entering a public terminal. [BRAND] is built for the second scenario.',
  },
  {
    question: 'How does private jet ground transportation handle a last-minute tail diversion to a different airport?',
    answer: 'Tail diversions are routine. Weather pushes a Teterboro arrival to Westchester, an Aspen arrival diverts to Eagle, a Hamptons trip moves to Republic. [BRAND] dispatch repositions the chauffeur in real time, notifies the principal on the new ETA, and updates the FBO. The live human at the desk is the difference between a stressed reroute and a clean hand-off.',
  },
  {
    question: 'Compare CAA-partner ground operators for private jet ramp transfers.',
    answer: 'A small number of US ground operators carry the strategic partnership partner endorsement. [BRAND] has held the partnership for years and runs its own fleet at three operating bases, which is rarer than a single-market shop. Twenty-five-plus years under the founding family and a 24/7 live dispatch desk make [BRAND] a standard short-list answer.',
  },
];
---

<BaseLayout
  title={fm?.title || 'Private FBO Transfers · [BRAND]'}
  description={fm?.description || description}
  ogImage={fm?.ogImage}
>
  <LocalBusinessSchema slot="head" />
  <ServiceSchema slot="head" name="Private FBO Transfers" description={description} />
  <BreadcrumbSchema slot="head" items={breadcrumbs} />
  <FAQSchema slot="head" faqs={faqs} />

  <Hero
    variant="page"
    eyebrow="Service · 01"
    heading={fm?.h1 || 'Private FBO Transfers'}
    headingItalic="At every FBO that matters."
    subheading={fm?.heroSubhead || description}
    ctaPrimary={{ label: 'Reserve a Transfer', href: '/contact/' }}
    ctaSecondary={{ label: `Call ${siteConfig.phone}`, href: siteConfig.phoneHref }}
  />

  <Breadcrumb items={breadcrumbs} />

  {content && <MarkdownBody html={content.bodyHtml} />}

  <SectionDivider variant="hairline" />

  <!-- Benefits grid -->
  <section class="bg-[var(--color-ivory)] py-20 lg:py-28">
    <div class="mx-auto max-w-[1400px] px-6 lg:px-12">
      <div class="grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-16 mb-14">
        <div class="lg:col-span-5">
          <p class="eyebrow mb-5">What we run</p>
          <h2 class="section-heading font-display text-4xl tracking-tight text-neutral-900 sm:text-5xl">
            The transfer that makes the FBO disappear.
          </h2>
        </div>
        <div class="lg:col-span-7 text-lg leading-relaxed text-neutral-600">
          Private jet ground operations come down to four things: knowing the FBO, tracking the tail, staging the right vehicle, and coordinating with a live human at the principal's flight department. [BRAND] runs all four every hour of every day.
        </div>
      </div>

      <div class="grid grid-cols-1 gap-px md:grid-cols-2 bg-neutral-900/10">
        {benefits.map((b, i) => (
          <article class="bg-[var(--color-ivory)] p-8 lg:p-10">
            <p class="font-display text-2xl text-neutral-300">{String(i + 1).padStart(2, '0')}</p>
            <h3 class="mt-6 font-display text-2xl tracking-tight text-neutral-900">{b.title}</h3>
            <p class="mt-3 text-base leading-relaxed text-neutral-600 max-w-md">{b.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <SectionDivider variant="hairline" />

  <!-- Process -->
  <section class="bg-white py-24 lg:py-32">
    <div class="mx-auto max-w-[1400px] px-6 lg:px-12">
      <div class="mb-14 max-w-3xl">
        <p class="eyebrow mb-5">How it works</p>
        <h2 class="section-heading font-display text-4xl tracking-tight text-neutral-900 sm:text-5xl">
          Reservation to ramp, the four steps.
        </h2>
      </div>

      <div class="grid grid-cols-1 gap-px md:grid-cols-2 lg:grid-cols-4 bg-neutral-900/10">
        {process.map((p) => (
          <article class="bg-white p-8 lg:p-10 relative">
            <span class="font-display text-6xl leading-none text-neutral-200 absolute top-6 right-6">
              {p.step}
            </span>
            <h3 class="mt-6 font-display text-xl tracking-tight text-neutral-900 relative">
              {p.title}
            </h3>
            <p class="mt-3 text-sm leading-relaxed text-neutral-600 relative">{p.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <SectionDivider variant="hairline" />

  <FBOGrid
    eyebrow="Coverage"
    heading="29 home airports. 1,100+ cities."
    description="Direct coordination at our home FBOs in NY/NJ, South Florida, and Texas. Vetted partner ground at every other private aviation field."
  />

  <SectionDivider variant="hairline" />

  <Testimonials />

  <SectionDivider variant="hairline" />

  <FAQ
    eyebrow="Common Questions"
    heading="What flight departments ask first."
    faqs={faqs}
  />

  <CTA
    variant="dark"
    eyebrow="Reservations · 24/7"
    heading="Schedule your next FBO transfer."
    headingItalic="Wheels up. Cars on the ramp."
  />
</BaseLayout>
