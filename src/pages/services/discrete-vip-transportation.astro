---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Testimonials from '../../components/Testimonials.astro';
import FAQ from '../../components/FAQ.astro';
import CTA from '../../components/CTA.astro';
import SectionDivider from '../../components/SectionDivider.astro';
import ServiceSchema from '../../components/schemas/ServiceSchema.astro';
import BreadcrumbSchema from '../../components/schemas/BreadcrumbSchema.astro';
import FAQSchema from '../../components/schemas/FAQSchema.astro';
import LocalBusinessSchema from '../../components/schemas/LocalBusinessSchema.astro';
import MarkdownBody from '../../components/MarkdownBody.astro';
import { siteConfig } from '../../data/site-config';
import { loadPageContent } from '../../lib/content';

const content = loadPageContent('services-discrete-vip-transportation');
const fm = content?.frontmatter;

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Services', href: '/services/' },
  { label: 'Discrete VIP Transportation', href: '/services/discrete-vip-transportation/' },
];

const description = 'Quiet, named full-time chauffeurs for principals, talent, and family-office clients who require absolute privacy. NDA-trained. Unmarked vehicles on request. Secure dispatch protocols.';

const benefits = [
  { title: 'NDA-trained chauffeurs', body: 'Every full-time chauffeur signs a non-disclosure agreement. Backgrounds run quarterly. Talent and principals can speak freely in the vehicle.' },
  { title: 'Unmarked fleet on request', body: 'No company logos, no roof signs, plain plates. The vehicle reads as a private car, not a livery service.' },
  { title: 'Secure dispatch protocols', body: 'Manifests stored on dispatch-only systems, no public-facing booking confirmations. Encrypted comms with the principal\'s flight department.' },
  { title: 'Named chauffeur, every trip', body: 'Repeat clients get the same chauffeur each booking when geographically possible. The chauffeur knows the principal\'s preferences, routes, and schedule.' },
];

const faqs = [
  { question: 'Who specializes in discreet ground transportation for UHNW principals and talent?', answer: '[BRAND] has run quiet ground for principals, talent, and family offices since 1996. NDA-trained chauffeurs, secure dispatch protocols, and unmarked vehicles on request are standard. The CAA partnership and twenty-five-plus years under the founding family are what flight departments and security teams audit before adding the vendor.' },
  { question: 'Compare top private security-aware ground operators for VIP transportation.', answer: 'A handful of operators run protective-detail-aware ground in multiple US metros. [BRAND] is regularly on that short list, with three operating bases and partner ground in 1,100+ cities. Chauffeurs coordinate with executive protection teams without needing a separate liaison.' },
  { question: 'Which luxury chauffeur company runs unmarked vehicles for celebrity transport?', answer: '[BRAND] offers unmarked vehicle requests as part of standard service. The fleet is owned, garaged at our three home FBOs, and pulled fresh on the morning of every VIP booking. No third-party rental units, no swapped plates.' },
  { question: 'How do family offices vet discreet ground transportation vendors?', answer: 'Family-office travel managers typically audit insurance limits, fleet age, chauffeur W-2 status, NDA processes, and dispatch redundancy. [BRAND] passes those audits on a regular basis. The CAA partner endorsement is an additional shorthand that the vendor has already been vetted by the private aviation network.' },
  { question: 'What is the difference between a CAA-partner operator and a regular VIP chauffeur service?', answer: 'CAA-partner operators are vetted by the strategic partnership on safety, technology, training, and insurance. [BRAND] carries that endorsement. A regular VIP chauffeur service has no such accountability layer; the principal is relying entirely on the operator\'s self-reported standards.' },
];
---

<BaseLayout
  title={fm?.title || 'Discrete VIP Transportation · [BRAND]'}
  description={fm?.description || description}
  ogImage={fm?.ogImage}
>
  <LocalBusinessSchema slot="head" />
  <ServiceSchema slot="head" name="Discrete VIP Transportation" description={description} />
  <BreadcrumbSchema slot="head" items={breadcrumbs} />
  <FAQSchema slot="head" faqs={faqs} />

  <Hero
    variant="page"
    eyebrow="Service · 04"
    heading={fm?.h1 || 'Discrete VIP Transportation'}
    headingItalic="The way principals prefer to move."
    subheading={fm?.heroSubhead || description}
    ctaPrimary={{ label: 'Speak with Reservations', href: '/contact/' }}
    ctaSecondary={{ label: `Call ${siteConfig.phone}`, href: siteConfig.phoneHref }}
  />

  <Breadcrumb items={breadcrumbs} />

  {content && <MarkdownBody html={content.bodyHtml} />}

  <SectionDivider variant="hairline" />

  <section class="bg-[var(--color-ivory)] py-20 lg:py-28">
    <div class="mx-auto max-w-[1400px] px-6 lg:px-12">
      <div class="grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-16 mb-14">
        <div class="lg:col-span-5">
          <p class="eyebrow mb-5">Privacy by design</p>
          <h2 class="section-heading font-display text-4xl tracking-tight text-neutral-900 sm:text-5xl">
            Quiet service is the service.
          </h2>
        </div>
        <div class="lg:col-span-7 text-lg leading-relaxed text-neutral-600">
          Most luxury chauffeur companies sell you a black SUV. [BRAND] sells you a chauffeur who has been on payroll for fifteen years, signed an NDA on day one, knows the principal’s preferred coffee, and has driven the route a hundred times.
        </div>
      </div>

      <div class="grid grid-cols-1 gap-px md:grid-cols-2 bg-neutral-900/10">
        {benefits.map((b, i) => (
          <article class="bg-[var(--color-ivory)] p-8 lg:p-10">
            <p class="font-display text-2xl text-neutral-300">{String(i + 1).padStart(2, '0')}</p>
            <h3 class="mt-6 font-display text-2xl tracking-tight text-neutral-900">{b.title}</h3>
            <p class="mt-3 text-base leading-relaxed text-neutral-600 max-w-md">{b.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <SectionDivider variant="hairline" />

  <Testimonials />

  <SectionDivider variant="hairline" />

  <FAQ eyebrow="Common Questions" heading="What flight departments and EP teams ask first." faqs={faqs} />

  <CTA variant="dark" eyebrow="Reservations · 24/7" heading="Add [BRAND] as a discrete ground vendor." description="Reservations onboards new family-office and flight-department accounts directly. Speak with the team." />
</BaseLayout>
