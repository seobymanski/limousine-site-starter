---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CTA from '../../components/CTA.astro';
import SectionDivider from '../../components/SectionDivider.astro';
import LocalBusinessSchema from '../../components/schemas/LocalBusinessSchema.astro';
import BreadcrumbSchema from '../../components/schemas/BreadcrumbSchema.astro';
import {
  fetchBlogPostBySlugAndCategory,
  fetchBlogPostBySlugAndCategoryAnyStatus,
} from '../../lib/payload';
import { siteConfig } from '../../data/site-config';

export const prerender = false;

const { slug } = Astro.params;
const isPreview = Astro.url.searchParams.get('preview') === '1';

if (!slug) return Astro.redirect('/blog/');

const post = isPreview
  ? await fetchBlogPostBySlugAndCategoryAnyStatus(slug, 'blog').catch(() => null)
  : await fetchBlogPostBySlugAndCategory(slug, 'blog').catch(() => null);

if (!post) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Blog', href: '/blog/' },
  { label: post.title, href: `/blog/${post.slug}/` },
];

const title = post.metaTitle || `${post.title} · [BRAND]`;
const description = post.metaDescription || post.excerpt;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.title,
  description: post.excerpt,
  image: post.bannerImage || post.featuredImage,
  datePublished: post.publishedDate,
  author: { '@type': 'Person', name: post.author?.name || '[BRAND]' },
  publisher: {
    '@type': 'Organization',
    name: siteConfig.fullName,
    url: siteConfig.url,
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': `${siteConfig.url}/blog/${post.slug}/` },
};
---

<BaseLayout title={title} description={description} ogImage={post.bannerImage || post.featuredImage}>
  <LocalBusinessSchema slot="head" />
  <BreadcrumbSchema slot="head" items={breadcrumbs} />
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(articleSchema)} />

  {isPreview && (
    <div class="sticky top-0 z-50 bg-[color:var(--color-primary-500)] text-white text-center text-xs uppercase tracking-[0.18em] font-semibold py-2 px-4">
      Preview mode — Status: {post.status} · this post is not live to the public yet
    </div>
  )}

  <Hero
    variant="page"
    eyebrow={`Field Notes · ${new Date(post.publishedDate).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}`}
    heading={post.title}
    subheading={post.excerpt}
    minHeight="min-h-[44vh]"
  />

  <Breadcrumb items={breadcrumbs} />

  <SectionDivider variant="hairline" />

  <article class="bg-[var(--color-ivory)] py-20 lg:py-28">
    <div class="mx-auto max-w-3xl px-6 lg:px-12">
      {post.featuredImage && (
        <div class="aspect-[16/9] overflow-hidden bg-neutral-200 mb-12">
          <img src={post.featuredImage} alt={post.featuredImageAlt || post.title} class="h-full w-full object-cover" loading="eager" />
        </div>
      )}

      <div class="flex items-center gap-4 text-xs uppercase tracking-[0.14em] text-neutral-500 mb-10">
        <span>{post.readingTime} min read</span>
        {post.author?.name && <><span>·</span><span>By {post.author.name}</span></>}
      </div>

      <div class="prose-luxury" set:html={post.body}></div>
    </div>
  </article>

  <CTA variant="dark" eyebrow="Reservations · 24/7" heading="Wheels up. Cars on the ramp." description="Speak with reservations to schedule your next transfer." />
</BaseLayout>
