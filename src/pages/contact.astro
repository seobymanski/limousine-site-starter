---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import ContactForm from '../components/ContactForm.astro';
import OfficeLocations from '../components/OfficeLocations.astro';
import SectionDivider from '../components/SectionDivider.astro';
import LocalBusinessSchema from '../components/schemas/LocalBusinessSchema.astro';
import BreadcrumbSchema from '../components/schemas/BreadcrumbSchema.astro';
import { siteConfig } from '../data/site-config';
import { loadPageContent } from '../lib/content';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Contact', href: '/contact/' },
];

const content = loadPageContent('contact');
const fm = content?.frontmatter ?? {
  title: 'Contact Reservations · [BRAND]',
  description: 'Reach [BRAND] reservations 24/7 for FBO transfers, charter buses, and corporate accounts.',
  h1: 'Contact [BRAND]',
  heroSubhead: 'Live dispatch 24 hours a day, seven days a week.',
};
---

<BaseLayout title={fm.title} description={fm.description}>
  <LocalBusinessSchema slot="head" />
  <BreadcrumbSchema slot="head" items={breadcrumbs} />

  <Hero
    variant="page"
    eyebrow="Reservations · 24/7"
    heading={fm.h1}
    subheading={fm.heroSubhead}
    minHeight="min-h-[44vh]"
  />

  <Breadcrumb items={breadcrumbs} />

  <section class="bg-[var(--color-ivory)] py-20 lg:py-28">
    <div class="mx-auto max-w-[1400px] px-6 lg:px-12">
      <div class="grid grid-cols-1 gap-16 lg:grid-cols-12 lg:gap-20">
        <div class="lg:col-span-7">
          <p class="eyebrow mb-5">Send a Message</p>
          <h2 class="font-display text-4xl tracking-tight text-neutral-900 sm:text-5xl">
            Tell us about your trip.
          </h2>
          <p class="mt-4 text-neutral-600 max-w-xl">
            Reservations responds within an hour, every hour. For dispatch in the next sixty minutes, call directly.
          </p>

          <div class="mt-12">
            <ContactForm />
          </div>
        </div>

        <aside class="lg:col-span-5">
          <div class="border border-neutral-900/10 bg-white p-8 lg:p-10 space-y-8">
            <div>
              <p class="eyebrow mb-2">Reservations</p>
              <a href={siteConfig.phoneHref} class="font-display text-3xl tracking-tight hover:opacity-60 transition-opacity">
                {siteConfig.phone}
              </a>
              <p class="mt-2 text-xs uppercase tracking-[0.14em] text-neutral-500">
                {siteConfig.hours.label}
              </p>
            </div>

            <div class="border-t border-neutral-900/10 pt-8">
              <p class="eyebrow mb-2">Email</p>
              <a href={siteConfig.emailHref} class="text-base font-medium text-neutral-900 hover:opacity-60 transition-opacity">
                {siteConfig.email}
              </a>
              <p class="mt-2 text-xs text-neutral-500 leading-relaxed">
                Response within one hour, every hour, every day.
              </p>
            </div>

            <div class="border-t border-neutral-900/10 pt-8">
              <p class="eyebrow mb-2">Headquarters</p>
              <p class="font-display text-xl tracking-tight">{siteConfig.address.fbo}</p>
              <p class="text-xs uppercase tracking-[0.14em] text-neutral-500 mt-1">
                {siteConfig.address.airport} · Teterboro Airport
              </p>
              <p class="mt-3 text-sm text-neutral-600 leading-relaxed">
                {siteConfig.address.street}<br />
                {siteConfig.address.city}, {siteConfig.address.state} {siteConfig.address.zip}
              </p>
            </div>

            <div class="border-t border-neutral-900/10 pt-8">
              <p class="eyebrow mb-3">Partner Listing</p>
              <p class="text-sm text-neutral-700 leading-relaxed">
                {siteConfig.partnerships.caa.label}.
              </p>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <SectionDivider variant="hairline" />

  <OfficeLocations
    eyebrow="Operating Bases"
    heading="Three offices. Three home FBOs."
    description="Walk-up reservations, lost-and-found returns, and corporate-account onboarding at any of our three operating bases."
  />
</BaseLayout>
