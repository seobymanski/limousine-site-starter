---
import { siteConfig } from '../data/site-config';

interface Props {
  /** Pre-fill the subject (e.g. "Aspen Airport Transfer Request") */
  subject?: string;
}

const { subject = '' } = Astro.props;

const subjectOptions = [
  'New Reservation',
  'FBO Transfer Inquiry',
  'Charter Bus / Group Service',
  'Corporate Account',
  'Existing Booking',
  'Other',
];
---

<form id="contact-form" class="space-y-2" method="POST" action="/api/contact">
  <input type="text" name="_honey" tabindex="-1" autocomplete="off" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0;" aria-hidden="true" />

  <div class="grid grid-cols-1 gap-x-8 sm:grid-cols-2">
    <div class="form-field">
      <input type="text" id="name" name="name" placeholder=" " required autocomplete="name" />
      <label for="name">Full name *</label>
      <span class="form-field-error" id="err-name" role="alert" aria-live="polite"></span>
    </div>
    <div class="form-field">
      <input type="email" id="email" name="email" placeholder=" " required autocomplete="email" />
      <label for="email">Email *</label>
      <span class="form-field-error" id="err-email" role="alert" aria-live="polite"></span>
    </div>
    <div class="form-field">
      <input type="tel" id="phone" name="phone" placeholder=" " autocomplete="tel" />
      <label for="phone">Phone</label>
    </div>
    <div class="form-field">
      <select id="subject" name="subject" required>
        <option value="" disabled selected={!subject}></option>
        {subjectOptions.map((opt) => (
          <option value={opt} selected={subject === opt}>{opt}</option>
        ))}
      </select>
      <label for="subject">Subject *</label>
    </div>
  </div>

  <div class="form-field sm:col-span-2">
    <textarea id="message" name="message" placeholder=" " rows="5" required></textarea>
    <label for="message">Message *</label>
    <span class="form-field-error" id="err-message" role="alert" aria-live="polite"></span>
  </div>

  <div class="flex flex-col items-start justify-between gap-4 pt-8 sm:flex-row sm:items-center">
    <p class="text-xs text-neutral-500 max-w-xs leading-relaxed">
      Or call <a href={siteConfig.phoneHref} class="text-neutral-900 underline underline-offset-2">{siteConfig.phone}</a> for immediate dispatch. Reservations are answered live, twenty-four hours a day.
    </p>
    <button type="submit" class="btn-primary" id="submit-btn">
      <span class="btn-label">Send Message</span>
      <svg class="btn-spinner hidden animate-spin" width="14" height="14" viewBox="0 0 14 14" fill="none">
        <circle cx="7" cy="7" r="5.5" stroke="currentColor" stroke-width="1" stroke-dasharray="20 12" />
      </svg>
      <svg width="14" height="10" viewBox="0 0 14 10" fill="none" class="btn-arrow">
        <path d="M1 5H13M13 5L9 1M13 5L9 9" stroke="currentColor" stroke-width="1" />
      </svg>
    </button>
  </div>

  <div id="form-success" class="hidden mt-12 border-t border-neutral-900/10 pt-12 text-center">
    <svg width="56" height="56" viewBox="0 0 56 56" fill="none" class="mx-auto" aria-hidden="true">
      <circle cx="28" cy="28" r="27" stroke="currentColor" stroke-width="1" class="text-[var(--color-accent-500)]" />
      <path
        d="M16 29l8 8 16-18"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-dasharray="60"
        stroke-dashoffset="60"
        class="text-[var(--color-accent-500)]"
        style="animation: drawCheck 0.6s ease-out forwards 0.2s;"
      />
    </svg>
    <h3 class="mt-6 font-display text-2xl tracking-tight">Message received.</h3>
    <p class="mt-2 text-sm text-neutral-600 max-w-md mx-auto">
      Reservations will respond within an hour, every hour. For urgent dispatch, call {siteConfig.phone}.
    </p>
  </div>

  <div id="form-error" class="hidden mt-4 text-sm text-red-700"></div>
</form>

<script>
  function initForm() {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    if (!form) return;

    const submitBtn = form.querySelector<HTMLButtonElement>('#submit-btn');
    const successBox = document.getElementById('form-success');
    const errorBox = document.getElementById('form-error');

    function shake(field: HTMLElement) {
      field.classList.add('has-error');
      const start = performance.now();
      const dur = 480;
      const seq = [-8, 8, -6, 6, -3, 3, 0];
      let i = 0;
      const step = (t: number) => {
        const elapsed = t - start;
        if (elapsed >= dur || i >= seq.length) {
          field.style.transform = '';
          return;
        }
        const idx = Math.floor((elapsed / dur) * seq.length);
        if (idx !== i) {
          i = idx;
          field.style.transform = `translateX(${seq[i] || 0}px)`;
        }
        requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    }

    function setError(name: string, msg: string) {
      const el = document.getElementById(`err-${name}`);
      if (el) el.textContent = msg;
      const field = form!.querySelector<HTMLElement>(`[name="${name}"]`)?.closest('.form-field');
      if (field instanceof HTMLElement) {
        shake(field);
      }
    }

    function clearErrors() {
      ['name', 'email', 'message'].forEach((n) => {
        const el = document.getElementById(`err-${n}`);
        if (el) el.textContent = '';
      });
      form!.querySelectorAll('.form-field.has-error').forEach((f) => f.classList.remove('has-error'));
      if (errorBox) errorBox.classList.add('hidden');
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      clearErrors();

      const fd = new FormData(form);
      const name = (fd.get('name') as string)?.trim();
      const email = (fd.get('email') as string)?.trim();
      const message = (fd.get('message') as string)?.trim();

      let valid = true;
      if (!name) { setError('name', 'Please enter your name'); valid = false; }
      if (!email) { setError('email', 'Email is required'); valid = false; }
      else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { setError('email', 'Please enter a valid email'); valid = false; }
      if (!message) { setError('message', 'Please tell us how we can help'); valid = false; }
      if (!valid) return;

      // Lock the button
      submitBtn?.setAttribute('disabled', 'true');
      const label = submitBtn?.querySelector('.btn-label');
      const spinner = submitBtn?.querySelector('.btn-spinner');
      const arrow = submitBtn?.querySelector('.btn-arrow');
      label?.classList.add('opacity-50');
      spinner?.classList.remove('hidden');
      arrow?.classList.add('hidden');

      try {
        const res = await fetch('/api/contact', { method: 'POST', body: fd });
        if (!res.ok) {
          const data = await res.json().catch(() => ({}));
          if (errorBox) {
            errorBox.textContent = (data as any).error || 'Something went wrong. Please try again or call us.';
            errorBox.classList.remove('hidden');
          }
        } else {
          form.classList.add('hidden');
          successBox?.classList.remove('hidden');
        }
      } catch (err) {
        if (errorBox) {
          errorBox.textContent = 'Network error. Please call us at ' + (form?.dataset.phone || '');
          errorBox.classList.remove('hidden');
        }
      } finally {
        submitBtn?.removeAttribute('disabled');
        label?.classList.remove('opacity-50');
        spinner?.classList.add('hidden');
        arrow?.classList.remove('hidden');
      }
    });
  }

  initForm();
  document.addEventListener('astro:page-load', initForm);
</script>
