---
import { siteConfig } from '../data/site-config';
import { footerLinks } from '../data/navigation';
import CAABadge from './CAABadge.astro';
import PaymentMethods from './PaymentMethods.astro';

const year = new Date().getFullYear();
---

<footer class="relative mt-32 border-t border-neutral-900/10 bg-[var(--color-ivory)]">
  <div class="mx-auto max-w-[1400px] px-6 py-20 lg:px-12 lg:py-24">
    <div class="grid grid-cols-1 gap-12 md:grid-cols-12 lg:gap-16">
      <!-- Brand block -->
      <div class="md:col-span-4">
        <a href="/" class="inline-flex items-baseline">
          <span class="font-display text-2xl tracking-tight">
            <span class="font-medium">Unique</span>
            <span class="font-normal italic text-[0.85em]">II</span>
            <span class="font-medium">Worldwide</span>
          </span>
        </a>
        <div class="mt-5">
          <CAABadge variant="inline" />
        </div>
        <p class="mt-6 text-sm leading-relaxed text-neutral-600 max-w-sm">
          Premier private jet ground transportation since {siteConfig.founded}. Direct-to-FBO transfers, discrete VIP service, and luxury chauffeurs across more than 1,100 cities worldwide.
        </p>

        <div class="mt-8 flex items-center gap-3">
          {siteConfig.social.facebook && (
            <a
              href={siteConfig.social.facebook}
              aria-label="Facebook"
              class="flex h-10 w-10 items-center justify-center border border-neutral-900/15 text-neutral-700 transition-all hover:bg-neutral-900 hover:text-[var(--color-ivory)] hover:border-neutral-900"
              target="_blank"
              rel="noopener"
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 4.97 3.66 9.1 8.44 9.84v-6.96H7.9v-2.88h2.54V9.85c0-2.51 1.49-3.9 3.78-3.9 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56v1.87h2.78l-.44 2.88h-2.34V22c4.78-.74 8.43-4.87 8.43-9.94Z"/></svg>
            </a>
          )}
          {siteConfig.social.instagram && (
            <a
              href={siteConfig.social.instagram}
              aria-label="Instagram"
              class="flex h-10 w-10 items-center justify-center border border-neutral-900/15 text-neutral-700 transition-all hover:bg-neutral-900 hover:text-[var(--color-ivory)] hover:border-neutral-900"
              target="_blank"
              rel="noopener"
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37Z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
            </a>
          )}
          {siteConfig.social.linkedin && (
            <a
              href={siteConfig.social.linkedin}
              aria-label="LinkedIn"
              class="flex h-10 w-10 items-center justify-center border border-neutral-900/15 text-neutral-700 transition-all hover:bg-neutral-900 hover:text-[var(--color-ivory)] hover:border-neutral-900"
              target="_blank"
              rel="noopener"
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.13 1.45-2.13 2.94v5.67H9.36V9h3.41v1.56h.05c.48-.9 1.65-1.85 3.4-1.85 3.63 0 4.3 2.39 4.3 5.5v6.24ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13Zm1.78 13.02H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.99 0 1.78-.77 1.78-1.72V1.72C24 .77 23.21 0 22.22 0Z"/></svg>
            </a>
          )}
          {siteConfig.social.google && (
            <a
              href={siteConfig.social.google}
              aria-label="Google Business Profile"
              class="flex h-10 w-10 items-center justify-center border border-neutral-900/15 text-neutral-700 transition-all hover:bg-neutral-900 hover:text-[var(--color-ivory)] hover:border-neutral-900"
              target="_blank"
              rel="noopener"
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M21.35 11.1H12v3.5h5.35c-.45 2.4-2.5 3.85-5.35 3.85-3.25 0-5.85-2.6-5.85-5.85S8.75 6.75 12 6.75c1.45 0 2.75.5 3.75 1.45l2.6-2.6C16.7 3.95 14.5 3 12 3 6.95 3 2.85 7.1 2.85 12.15S6.95 21.3 12 21.3c5.5 0 9.15-3.85 9.15-9.3 0-.6-.05-1.2-.15-1.75 0 0 .35.85.35.85Z"/></svg>
            </a>
          )}
        </div>
      </div>

      <!-- Services -->
      <div class="md:col-span-3">
        <h3 class="eyebrow mb-5">Services</h3>
        <ul class="space-y-3">
          {footerLinks.services.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-neutral-700 hover:text-neutral-900 transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Offices -->
      <div class="md:col-span-5">
        <h3 class="eyebrow mb-5">Operating Bases</h3>
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-3">
          {siteConfig.offices.map((office) => (
            <div class="space-y-1">
              <p class="text-sm font-medium text-neutral-900">
                {office.label}
              </p>
              <p class="text-sm text-neutral-600">{office.fbo}</p>
              <p class="text-xs uppercase tracking-[0.12em] text-neutral-500">{office.airport}</p>
              <p class="text-xs text-neutral-500 leading-relaxed pt-2">
                {office.street}<br />
                {office.city}, {office.state} {office.zip}
              </p>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Contact strip -->
    <div class="mt-16 grid grid-cols-1 gap-8 border-t border-neutral-900/10 pt-10 md:grid-cols-3">
      <div>
        <p class="eyebrow mb-2">Reservations</p>
        <a href={siteConfig.phoneHref} class="font-display text-2xl tracking-tight hover:opacity-60 transition-opacity">
          {siteConfig.phone}
        </a>
        <p class="text-xs text-neutral-500 mt-1">{siteConfig.hours.label}</p>
      </div>
      <div>
        <p class="eyebrow mb-2">Email</p>
        <a href={siteConfig.emailHref} class="text-base hover:opacity-60 transition-opacity">
          {siteConfig.email}
        </a>
      </div>
      <div class="md:text-right">
        <a href="/contact/" class="btn-secondary">Reserve a Transfer</a>
      </div>
    </div>

    <!-- Payment methods -->
    <div class="mt-12 border-t border-neutral-900/10 pt-8">
      <PaymentMethods />
    </div>

    <!-- Bottom bar -->
    <div class="mt-12 flex flex-col items-start justify-between gap-4 border-t border-neutral-900/10 pt-8 md:flex-row md:items-center">
      <p class="text-xs text-neutral-500">
        &copy; {year} {siteConfig.name}. All rights reserved.
      </p>
      <div class="flex items-center gap-6">
        <a href="/privacy/" class="text-xs text-neutral-500 hover:text-neutral-900">Privacy</a>
        <a href="/terms/" class="text-xs text-neutral-500 hover:text-neutral-900">Terms</a>
        <button
          type="button"
          id="back-to-top"
          class="text-xs uppercase tracking-[0.12em] text-neutral-500 hover:text-neutral-900 transition-colors flex items-center gap-2"
        >
          Back to top
          <svg width="10" height="10" viewBox="0 0 10 10" fill="none">
            <path d="M5 8.5V1.5M5 1.5L1.5 5M5 1.5L8.5 5" stroke="currentColor" stroke-width="1" />
          </svg>
        </button>
      </div>
    </div>
  </div>
</footer>

<script>
  function initFooter() {
    const btn = document.getElementById('back-to-top');
    if (!btn) return;
    btn.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }
  initFooter();
  document.addEventListener('astro:page-load', initFooter);
</script>
