---
import { siteConfig } from '../data/site-config';

interface Props {
  eyebrow?: string;
  heading?: string;
  description?: string;
  bare?: boolean;
}

const {
  eyebrow = 'Operating Bases',
  heading = 'Three offices, one network.',
  description = 'Direct ramp coordination at our home FBOs in New York / New Jersey, South Florida, and Texas, with full-service partner reach in 1,100+ cities.',
  bare = false,
} = Astro.props;
---

<section class="bg-white py-24 lg:py-32">
  <div class="mx-auto max-w-[1400px] px-6 lg:px-12">
    {!bare && (
      <div class="mb-14 lg:mb-20 max-w-3xl">
        <p class="eyebrow mb-5">{eyebrow}</p>
        <h2 class="section-heading font-display text-4xl leading-[1.08] tracking-tight text-neutral-900 sm:text-5xl lg:text-6xl">
          {heading}
        </h2>
        {description && <p class="mt-5 text-lg text-neutral-600">{description}</p>}
      </div>
    )}

    <div class="grid grid-cols-1 gap-px md:grid-cols-3 bg-neutral-900/10">
      {siteConfig.offices.map((office) => (
        <div class="bg-[var(--color-ivory)] p-8 lg:p-10 flex flex-col">
          <p class="eyebrow mb-3">
            {office.isHQ ? 'Headquarters' : 'Office'}
          </p>
          <h3 class="font-display text-2xl tracking-tight text-neutral-900">
            {office.label}
          </h3>
          <div class="mt-6 space-y-3 text-sm text-neutral-700 flex-1">
            <p class="font-medium">{office.fbo}</p>
            <p class="text-xs uppercase tracking-[0.14em] text-neutral-500">{office.airport} · {office.city} {office.state}</p>
            <div class="pt-3 border-t border-neutral-900/10">
              <p class="text-neutral-600 leading-relaxed">
                {office.street}<br />
                {office.city}, {office.state} {office.zip}
              </p>
            </div>
          </div>
          <a
            href={`/airports/${office.airport.toLowerCase()}/`}
            class="mt-6 link-underline tracked-nav inline-flex items-center gap-2 text-neutral-900 self-start"
          >
            View airport
          </a>
        </div>
      ))}
    </div>
  </div>
</section>
