---
interface Props {
  title: string;
  description: string;
  href: string;
  /** Display index (e.g. "01", "02"). Used as oversized watermark. */
  index?: string;
  image?: string;
  imageAlt?: string;
  /** When true, card spans 2 cols / 2 rows in the bento grid */
  featured?: boolean;
}

const { title, description, href, index, image, imageAlt = '', featured = false } = Astro.props;
---

<a
  href={href}
  class:list={[
    'service-card group relative flex flex-col border border-neutral-900/10 bg-[var(--color-ivory)] p-8 transition-all duration-500',
    'hover:border-neutral-900 hover:bg-white hover:shadow-lg',
    featured ? 'lg:col-span-2 lg:row-span-2 lg:p-12' : '',
  ]}
>
  {index && (
    <span class="font-display text-sm tracking-[0.18em] text-neutral-400">{index}</span>
  )}

  {image && featured && (
    <div class="relative mt-8 aspect-[16/10] w-full overflow-hidden bg-neutral-200">
      <img
        src={image}
        alt={imageAlt}
        class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.04]"
        loading="lazy"
      />
    </div>
  )}

  <h3 class:list={[
    'mt-6 font-display tracking-tight text-neutral-900',
    featured ? 'text-3xl lg:text-4xl' : 'text-2xl',
  ]}>
    {title}
  </h3>

  <p class:list={[
    'mt-3 text-neutral-600 leading-relaxed',
    featured ? 'text-base max-w-xl' : 'text-sm',
  ]}>
    {description}
  </p>

  <div class="mt-auto pt-8 flex items-center gap-2 text-xs uppercase tracking-[0.14em] text-neutral-700">
    <span>Explore</span>
    <svg
      width="20"
      height="10"
      viewBox="0 0 20 10"
      fill="none"
      class="transition-transform duration-500 group-hover:translate-x-1.5"
    >
      <path d="M1 5H19M19 5L15 1M19 5L15 9" stroke="currentColor" stroke-width="1" />
    </svg>
  </div>

  <!-- Top accent hairline that grows on hover -->
  <span class="absolute left-0 top-0 h-px w-0 bg-neutral-900 transition-all duration-500 group-hover:w-full"></span>
</a>
