---
/**
 * PageTransition
 * Subtle ivory wipe on Astro view-transitions. No-op when reduced-motion is on.
 */
---

<div class="page-transition" id="page-transition" aria-hidden="true"></div>

<script>
  const overlay = document.getElementById('page-transition');
  if (overlay) {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const dur = prefersReducedMotion ? 0 : 320;

    function setStyle(scale: number, origin: 'left' | 'right') {
      overlay!.style.transformOrigin = origin;
      overlay!.style.transition = `transform ${dur}ms cubic-bezier(0.65, 0, 0.35, 1)`;
      overlay!.style.transform = `scaleX(${scale})`;
    }

    document.addEventListener('astro:before-preparation', () => {
      setStyle(1, 'left');
    });
    document.addEventListener('astro:after-swap', () => {
      // The new page is now mounted with the wipe still covering it.
      requestAnimationFrame(() => setStyle(0, 'right'));
    });
    document.addEventListener('astro:page-load', () => {
      setStyle(0, 'right');
    });
  }
</script>
