---
/**
 * StatBar — editorial stats row for the homepage.
 * Numbers count up on scroll into view. Sleek minimal: black on ivory,
 * thin hairline separators, oversized serif numbers.
 */

interface Stat {
  /** Numeric target for count-up. Use null/undefined for non-numeric labels. */
  value: number;
  /** Suffix appended after the count-up (e.g. "+", "yrs", "k") */
  suffix?: string;
  /** Prefix (e.g. "$") */
  prefix?: string;
  label: string;
}

interface Props {
  stats?: Stat[];
}

const defaultStats: Stat[] = [
  { value: 1996, label: 'Year founded' },
  { value: 1100, suffix: '+', label: 'Cities served' },
  { value: 29, label: 'Major FBOs' },
  { value: 24, suffix: '/7', label: 'Live reservations' },
];

const { stats = defaultStats } = Astro.props;
---

<section class="relative bg-neutral-900 text-[var(--color-ivory)] py-16 lg:py-24">
  <div class="mx-auto max-w-[1400px] px-6 lg:px-12">
    <div class="grid grid-cols-2 gap-y-12 lg:grid-cols-4 lg:gap-y-0">
      {stats.map((s, i) => (
        <div class:list={[
          'relative px-2 lg:px-8',
          i > 0 && 'lg:border-l lg:border-l-[var(--color-ivory)]/15',
        ]}>
          <p
            class="stat-number font-display text-5xl tracking-tight sm:text-6xl lg:text-7xl"
            data-target={s.value}
            data-suffix={s.suffix || ''}
            data-prefix={s.prefix || ''}
          >
            {s.prefix || ''}0{s.suffix || ''}
          </p>
          <p class="mt-3 text-xs uppercase tracking-[0.16em] text-[var(--color-ivory)]/60">
            {s.label}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  function initStats() {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const stats = document.querySelectorAll<HTMLElement>('.stat-number');
    if (!stats.length) return;

    function countUp(el: HTMLElement) {
      const target = parseInt(el.dataset.target || '0', 10);
      const suffix = el.dataset.suffix || '';
      const prefix = el.dataset.prefix || '';
      if (prefersReducedMotion) {
        el.textContent = `${prefix}${target.toLocaleString()}${suffix}`;
        return;
      }
      const dur = 1800;
      const start = performance.now();
      const startVal = 0;
      function step(t: number) {
        const elapsed = t - start;
        const progress = Math.min(elapsed / dur, 1);
        const eased = 1 - Math.pow(1 - progress, 3);
        const current = Math.round(startVal + (target - startVal) * eased);
        el.textContent = `${prefix}${current.toLocaleString()}${suffix}`;
        if (progress < 1) requestAnimationFrame(step);
      }
      requestAnimationFrame(step);
    }

    const obs = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            countUp(entry.target as HTMLElement);
            obs.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.4 }
    );
    stats.forEach((s) => obs.observe(s));
  }

  initStats();
  document.addEventListener('astro:page-load', initStats);
</script>
