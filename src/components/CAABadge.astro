---
/**
 * Partnership badge — visual badge for any industry/strategic partnership
 * the client wants to highlight (CAA, NLA, ABLA, etc.).
 *
 * TODO (per-client): wire to siteConfig.partnerships and rename if needed.
 * Variants: 'inline' for sitting next to other text, 'card' for a standalone block.
 */
interface Props {
  variant?: 'inline' | 'card'
  /** 2-4 letter abbreviation shown on the badge mark (e.g. "CAA") */
  abbr?: string
  /** Full partnership name (e.g. "Corporate Aircraft Association") */
  fullName?: string
}
const { variant = 'inline', abbr = 'CAA', fullName = 'Corporate Aircraft Association' } = Astro.props
---

{variant === 'card' ? (
  <div class="inline-flex flex-col items-center gap-3 border border-neutral-900/15 bg-white p-6 text-center">
    <div class="flex h-12 w-12 items-center justify-center rounded-full border border-neutral-900 bg-neutral-900 text-[var(--color-ivory)]">
      <span class="font-display text-base tracking-[0.08em]">{abbr}</span>
    </div>
    <div>
      <p class="eyebrow">Official Partner</p>
      <p class="mt-1 font-display text-sm leading-tight text-neutral-900">
        {fullName}
      </p>
    </div>
  </div>
) : (
  <div class="inline-flex items-center gap-3 border border-neutral-900/15 bg-white px-4 py-2.5">
    <div class="flex h-7 w-7 items-center justify-center rounded-full bg-neutral-900 text-[var(--color-ivory)]">
      <span class="font-display text-[0.6rem] tracking-[0.08em]">{abbr}</span>
    </div>
    <div class="leading-tight">
      <p class="text-[0.6rem] font-medium uppercase tracking-[0.12em] text-neutral-500">Official Partner</p>
      <p class="text-xs font-medium text-neutral-900">{fullName}</p>
    </div>
  </div>
)}
