---
/**
 * TopServicesBlock
 *
 * Renders the "Top 3 Services" section on location and airport pages. Each
 * entry is a heading + rich-text body (already converted to HTML by the
 * payload lib).
 */

interface ServiceEntry {
  heading: string;
  body: string;
}

interface Props {
  eyebrow?: string;
  heading?: string;
  services: ServiceEntry[];
}

const { eyebrow = 'Services', heading = 'What we run on the ground here.', services } = Astro.props;
---

{services.length > 0 && (
  <section class="bg-white py-20 lg:py-28">
    <div class="mx-auto max-w-[1400px] px-6 lg:px-12">
      <div class="mb-12 lg:mb-16 max-w-3xl">
        <p class="eyebrow mb-4">{eyebrow}</p>
        <h2 class="section-heading font-display text-3xl leading-[1.1] tracking-tight text-neutral-900 sm:text-4xl lg:text-5xl">
          {heading}
        </h2>
      </div>

      <div class="grid grid-cols-1 gap-px md:grid-cols-3 bg-neutral-900/10">
        {services.map((s, i) => (
          <article class="bg-white p-8 lg:p-10">
            <p class="text-xs uppercase tracking-[0.14em] text-neutral-500 mb-4">
              {String(i + 1).padStart(2, '0')}
            </p>
            <h3 class="font-display text-xl tracking-tight text-neutral-900 sm:text-2xl mb-4 leading-[1.15]">
              {s.heading}
            </h3>
            <div class="prose-luxury prose-sm text-neutral-600 leading-relaxed" set:html={s.body}></div>
          </article>
        ))}
      </div>
    </div>
  </section>
)}
