---
import { siteConfig } from '../data/site-config';
import { primaryNav } from '../data/navigation';

interface Props {
  transparent?: boolean;
}

const { transparent = false } = Astro.props;
---

<header
  class:list={[
    'site-header sticky top-0 z-40 w-full text-neutral-900',
    transparent
      ? 'bg-[var(--color-ivory)]/85 backdrop-blur-md border-b border-neutral-900/8'
      : 'bg-[var(--color-ivory)] border-b border-neutral-900/8',
  ]}
  data-transparent={transparent ? 'true' : 'false'}
>
  <div class="scroll-progress-bar absolute top-0 left-0" id="scroll-progress"></div>

  <div class="mx-auto flex max-w-[1400px] items-center justify-between px-6 py-4 lg:px-12 lg:py-5">
    <!-- Logo -->
    <a href="/" class="group relative flex items-center" aria-label={` home`}>
      <img
        src="/brand/logo.svg"
        alt={siteConfig.name}
        class="site-logo h-10 w-auto md:h-12 transition-opacity hover:opacity-80"
      />
    </a>

    <!-- Desktop nav -->
    <nav aria-label="Primary" class="hidden lg:flex items-center gap-9">
      {primaryNav.map((item) => (
        <div class="group relative">
          <a
            href={item.href}
            class="tracked-nav inline-flex items-center gap-1.5 transition-opacity hover:opacity-60"
          >
            {item.label}
            {item.children && (
              <svg width="9" height="6" viewBox="0 0 9 6" fill="none" class="opacity-50">
                <path d="M1 1L4.5 4.5L8 1" stroke="currentColor" stroke-width="1" />
              </svg>
            )}
          </a>

          {item.children && (
            <div
              class="invisible absolute left-1/2 top-full z-50 mt-3 w-72 -translate-x-1/2 translate-y-1 opacity-0 transition-all duration-300 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100"
            >
              <div class="bg-[var(--color-ivory)] border border-neutral-900/8 shadow-lg p-2">
                {item.children.map((child) => (
                  <a
                    href={child.href}
                    class="block px-4 py-3 text-sm text-neutral-700 hover:bg-neutral-100 hover:text-neutral-900 transition-colors"
                  >
                    {child.label}
                  </a>
                ))}
                <a
                  href={item.href}
                  class="mt-1 block border-t border-neutral-900/8 px-4 py-3 text-[0.7rem] uppercase tracking-[0.12em] text-neutral-500 hover:text-neutral-900 transition-colors"
                >
                  View all
                </a>
              </div>
            </div>
          )}
        </div>
      ))}
    </nav>

    <!-- Right cluster -->
    <div class="flex items-center gap-3 lg:gap-5">
      <a
        href={siteConfig.phoneHref}
        class="hidden md:inline-flex tracked-nav items-center gap-2 transition-opacity hover:opacity-60"
        aria-label={`Call ${siteConfig.phone}`}
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92Z"/>
        </svg>
        <span>{siteConfig.phone}</span>
      </a>

      <a href="/contact/" class="hidden lg:inline-flex btn-primary">
        Reserve
      </a>

      <button
        type="button"
        id="mobile-menu-toggle"
        aria-label="Toggle menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="lg:hidden relative h-10 w-10 flex flex-col items-center justify-center gap-[5px]"
      >
        <span class="block h-px w-6 bg-current transition-transform duration-300 origin-center" data-bar="top"></span>
        <span class="block h-px w-6 bg-current transition-opacity duration-300" data-bar="middle"></span>
        <span class="block h-px w-6 bg-current transition-transform duration-300 origin-center" data-bar="bottom"></span>
      </button>
    </div>
  </div>
</header>

<!-- Mobile menu (rendered outside header so backdrop-filter doesn't clip it) -->
<div
  id="mobile-menu"
  class="fixed inset-0 z-[45] hidden bg-[var(--color-ivory)] lg:hidden"
  aria-hidden="true"
>
  <div class="flex h-full flex-col overflow-y-auto px-6 pb-12 pt-24">
    <nav aria-label="Mobile" class="flex flex-col gap-1">
      {primaryNav.map((item) => (
        <details class="group border-b border-neutral-900/10">
          <summary class="flex cursor-pointer items-center justify-between py-5 text-2xl font-display tracking-tight">
            <a href={item.href} class="block">{item.label}</a>
            {item.children && (
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" class="transition-transform group-open:rotate-45">
                <path d="M7 1V13M1 7H13" stroke="currentColor" stroke-width="1" />
              </svg>
            )}
          </summary>
          {item.children && (
            <div class="pb-5 pl-2 flex flex-col gap-3">
              {item.children.map((child) => (
                <a href={child.href} class="text-sm text-neutral-600 hover:text-neutral-900">
                  {child.label}
                </a>
              ))}
            </div>
          )}
        </details>
      ))}
    </nav>

    <div class="mt-10 space-y-4">
      <a href={siteConfig.phoneHref} class="block tracked-nav">{siteConfig.phone}</a>
      <a href={siteConfig.emailHref} class="block tracked-nav">{siteConfig.email}</a>
      <a href="/contact/" class="btn-primary mt-4 w-full justify-center">Reserve a Transfer</a>
    </div>
  </div>
</div>

<script>
  function initHeader() {
    const header = document.querySelector<HTMLElement>('.site-header');
    const progressBar = document.getElementById('scroll-progress');
    if (!header || !progressBar) return;

    function update() {
      const scrollTop = document.documentElement.scrollTop || document.body.scrollTop;
      const docHeight =
        (document.documentElement.scrollHeight || document.body.scrollHeight) - window.innerHeight;
      const progress = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
      progressBar!.style.width = `${progress}%`;

      const scrolled = scrollTop > 80;
      header!.classList.toggle('header-scrolled', scrolled);
    }
    update();
    window.addEventListener('scroll', update, { passive: true });

    // Mobile menu toggle
    const toggle = document.getElementById('mobile-menu-toggle');
    const menu = document.getElementById('mobile-menu');
    if (toggle && menu) {
      const topBar = toggle.querySelector<HTMLElement>('[data-bar="top"]');
      const midBar = toggle.querySelector<HTMLElement>('[data-bar="middle"]');
      const botBar = toggle.querySelector<HTMLElement>('[data-bar="bottom"]');

      toggle.addEventListener('click', () => {
        const isOpen = menu.classList.contains('hidden');
        if (isOpen) {
          menu.classList.remove('hidden');
          menu.setAttribute('aria-hidden', 'false');
          toggle.setAttribute('aria-expanded', 'true');
          document.body.style.overflow = 'hidden';
          if (topBar) topBar.style.transform = 'translateY(6px) rotate(45deg)';
          if (midBar) midBar.style.opacity = '0';
          if (botBar) botBar.style.transform = 'translateY(-6px) rotate(-45deg)';
        } else {
          menu.classList.add('hidden');
          menu.setAttribute('aria-hidden', 'true');
          toggle.setAttribute('aria-expanded', 'false');
          document.body.style.overflow = '';
          if (topBar) topBar.style.transform = '';
          if (midBar) midBar.style.opacity = '';
          if (botBar) botBar.style.transform = '';
        }
      });
    }
  }

  initHeader();
  document.addEventListener('astro:page-load', initHeader);
</script>

