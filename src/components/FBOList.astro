---
/**
 * FBOList
 *
 * Renders the "FBO Operators on Field" block on airport pages. The most
 * important block on an airport page — names each major FBO with its
 * terminal/ramp, an optional URL, and a 1-2 sentence blurb (HTML).
 */

interface FBO {
  name: string;
  url?: string;
  terminal?: string;
  body?: string;
}

interface Props {
  airportName: string;
  operators: FBO[];
}

const { airportName, operators } = Astro.props;

// Pick a column count at the lg breakpoint that lets the FBO list fill the
// grid with no empty cells. For prime counts (5, 7) we fall back to 3 cols
// and accept a small texture pad — those airports are rare in practice.
function pickLgCols(n: number): number {
  if (n <= 1) return 1;
  if (n === 2) return 2;
  if (n === 3) return 3;
  if (n === 4) return 2;  // 2x2
  if (n === 6) return 3;  // 3x2
  if (n === 8) return 4;  // 4x2
  if (n === 9) return 3;  // 3x3
  if (n % 3 === 0) return 3;
  if (n % 4 === 0) return 4;
  if (n % 2 === 0) return 2;
  return 3; // primes (5, 7): pad with texture below
}

const lgCols = pickLgCols(operators.length);
const padCount = operators.length === 0 ? 0 : (lgCols - (operators.length % lgCols)) % lgCols;
---

{operators.length > 0 && (
  <section class="bg-[var(--color-ivory)] py-20 lg:py-28 border-y border-neutral-900/10">
    <div class="mx-auto max-w-[1400px] px-6 lg:px-12">
      <div class="mb-12 lg:mb-16 max-w-3xl">
        <p class="eyebrow mb-4">FBO Operators on Field</p>
        <h2 class="section-heading font-display text-3xl leading-[1.1] tracking-tight text-neutral-900 sm:text-4xl lg:text-5xl">
          Where we coordinate at {airportName}.
        </h2>
        <p class="mt-5 text-lg text-neutral-600 max-w-2xl">
          Every transfer is briefed against the operator on file for the inbound tail. Below are the FBOs currently on field.
        </p>
      </div>

      <div class={`grid grid-cols-1 gap-px md:grid-cols-2 bg-neutral-900/10 fbo-grid-cols-${lgCols}`}>
        {operators.map((fbo) => (
          <article class="bg-white p-7 lg:p-8 flex flex-col">
            <div class="flex items-start justify-between gap-4 mb-3">
              <h3 class="font-display text-xl tracking-tight text-neutral-900 sm:text-2xl leading-[1.15]">
                {fbo.url ? (
                  <a href={fbo.url} target="_blank" rel="noopener noreferrer" class="link-underline">
                    {fbo.name}
                  </a>
                ) : (
                  fbo.name
                )}
              </h3>
            </div>
            {fbo.terminal && (
              <p class="text-xs uppercase tracking-[0.14em] text-neutral-500 mb-4">
                {fbo.terminal}
              </p>
            )}
            {fbo.body && (
              <div
                class="prose-luxury prose-sm text-neutral-600 leading-relaxed"
                set:html={fbo.body}
              ></div>
            )}
          </article>
        ))}
        {padCount > 0 && (
          <article
            class="relative bg-cover bg-center min-h-[200px]"
            style={`grid-column: span ${padCount} / span ${padCount}; background-image: url('/textures/asphalt.svg');`}
            aria-hidden="true"
          ></article>
        )}
      </div>
    </div>
  </section>
)}

<style>
  /* Dynamic lg column count — picked above based on operator count to avoid
     empty grid cells. Tailwind can't generate these from a runtime variable,
     so we declare the static set here. */
  @media (min-width: 1024px) {
    .fbo-grid-cols-1 { grid-template-columns: 1fr; }
    .fbo-grid-cols-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .fbo-grid-cols-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .fbo-grid-cols-4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .fbo-grid-cols-5 { grid-template-columns: repeat(5, minmax(0, 1fr)); }
  }
</style>
