---
/**
 * OriginStory — [FOUNDER] 1996 founding narrative.
 * Two-column editorial: image left, text right (alternates on About page).
 */

interface Props {
  eyebrow?: string;
  heading?: string;
  /** Pre-formatted paragraphs (overrides default copy) */
  paragraphs?: string[];
  image?: string;
  imageAlt?: string;
  /** Reverse layout: text left, image right */
  reverse?: boolean;
}

const defaultParagraphs = [
  '[FOUNDER] started [BRAND] in 1996 with one Lincoln Town Car and a single rule: pick up on time, deliver clean, treat every passenger like the principal of a Fortune 500.',
  'Three decades later that rule still runs the dispatch desk. The fleet is larger, the geography is wider, and the technology is sharper. The standard is the same.',
  'Today [BRAND] is the official luxury chauffeured partner of the strategic partnership, with operating bases at Meridian Teterboro, Fontainebleau Aviation in Opa-Locka, and Business Jet Center at Dallas Love Field, plus ground coverage in over 1,100 cities worldwide.',
];

const {
  eyebrow = 'Since 1996',
  heading = 'Built on one Town Car. Run by the same standard.',
  paragraphs = defaultParagraphs,
  image,
  imageAlt = '',
  reverse = false,
} = Astro.props;
---

<section class="bg-[var(--color-ivory)] py-24 lg:py-32">
  <div class="mx-auto max-w-[1400px] px-6 lg:px-12">
    <div class={`grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-16 ${reverse ? 'lg:flex-row-reverse' : ''}`}>
      <div class={`relative ${reverse ? 'lg:order-2 lg:col-span-6' : 'lg:col-span-6'}`}>
        {image ? (
          <div class="relative aspect-[4/5] w-full overflow-hidden bg-neutral-200">
            <img src={image} alt={imageAlt} class="h-full w-full object-cover" loading="lazy" />
            <div class="pointer-events-none absolute -bottom-3 -left-3 h-24 w-24 border-l border-b border-[var(--color-accent-500)]"></div>
            <div class="pointer-events-none absolute -top-3 -right-3 h-24 w-24 border-r border-t border-[var(--color-accent-500)]"></div>
          </div>
        ) : (
          <div class="relative w-full">
            <!-- Top: logo card -->
            <div class="aspect-[4/3] w-full bg-black flex items-center justify-center p-12 lg:p-16">
              <img
                src="/brand/logo.svg"
                alt="[BRAND]"
                class="max-w-full max-h-full object-contain"
                loading="lazy"
              />
            </div>
            <!-- Bottom: stamp card -->
            <div class="mt-3 aspect-[16/9] w-full bg-black flex items-center justify-center p-10 lg:p-12">
              <img
                src="/brand/origin-stamp.svg"
                alt=""
                aria-hidden="true"
                class="max-w-full max-h-full object-contain"
                loading="lazy"
              />
            </div>
            <!-- Bronze accent corners (around the stacked pair) -->
            <div class="pointer-events-none absolute -bottom-3 -left-3 h-24 w-24 border-l border-b border-[var(--color-accent-500)]"></div>
            <div class="pointer-events-none absolute -top-3 -right-3 h-24 w-24 border-r border-t border-[var(--color-accent-500)]"></div>
          </div>
        )}
      </div>

      <div class={`flex flex-col justify-center ${reverse ? 'lg:order-1 lg:col-span-6' : 'lg:col-span-6'}`}>
        <p class="eyebrow mb-5">{eyebrow}</p>
        <h2 class="section-heading font-display text-4xl leading-[1.06] tracking-tight text-neutral-900 sm:text-5xl">
          {heading}
        </h2>
        <div class="mt-8 space-y-5 text-base leading-relaxed text-neutral-700 max-w-prose">
          {paragraphs.map((p) => <p>{p}</p>)}
        </div>

        <div class="mt-10 flex items-center gap-6 border-t border-neutral-900/10 pt-6">
          <div>
            <p class="text-xs uppercase tracking-[0.14em] text-neutral-500">Founder</p>
            <p class="mt-1 font-display text-lg tracking-tight">[FOUNDER]</p>
          </div>
          <div class="h-10 w-px bg-neutral-300"></div>
          <div>
            <p class="text-xs uppercase tracking-[0.14em] text-neutral-500">Founded</p>
            <p class="mt-1 font-display text-lg tracking-tight">1996</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
