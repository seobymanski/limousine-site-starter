---
import { siteConfig } from '../data/site-config';
import LocationCard from './LocationCard.astro';

interface Props {
  eyebrow?: string;
  heading?: string;
  description?: string;
  limit?: number;
  bare?: boolean;
}

const {
  eyebrow = 'Cities',
  heading = 'Where we serve, on the ground.',
  description,
  limit,
  bare = false,
} = Astro.props;

const items = limit ? siteConfig.cities.slice(0, limit) : siteConfig.cities;
---

<section class="bg-white py-24 lg:py-32">
  <div class="mx-auto max-w-[1400px] px-6 lg:px-12">
    {!bare && (
      <div class="mb-14 flex flex-col items-start justify-between gap-6 lg:mb-20 lg:flex-row lg:items-end">
        <div class="max-w-2xl">
          <p class="eyebrow mb-5">{eyebrow}</p>
          <h2 class="section-heading font-display text-4xl leading-[1.08] tracking-tight text-neutral-900 sm:text-5xl lg:text-6xl">
            {heading}
          </h2>
          {description && <p class="mt-5 text-lg text-neutral-600">{description}</p>}
        </div>
        <a href="/private-jet-transfer/" class="link-underline tracked-nav shrink-0">
          View all cities
        </a>
      </div>
    )}

    <div class="grid grid-cols-1 gap-px sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 bg-neutral-900/10">
      {items.map((loc) => (
        <LocationCard
          city={loc.city}
          state={loc.state}
          detail={loc.region}
          href={`/private-jet-transfer/${loc.slug}/`}
        />
      ))}
    </div>
  </div>
</section>
