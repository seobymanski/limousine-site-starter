{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  // TODO (per-client): set to "<client>-cms"
  "name": "starter-cms",
  "compatibility_date": "2025-08-15",
  // Per-client: once the client zone is on Cloudflare, attach a friendly
  // CMS subdomain so editors hit https://cms.<client-domain>.com instead of
  // the generic .workers.dev URL. Setting `workers_dev: false` retires the
  // workers.dev URL once the custom domain is live.
  // "workers_dev": false,
  // "routes": [
  //   { "pattern": "cms.CLIENT-DOMAIN.com", "custom_domain": true },
  // ],
  "compatibility_flags": [
    // Enable Node.js API
    // see https://developers.cloudflare.com/workers/configuration/compatibility-flags/#nodejs-compatibility-flag
    "nodejs_compat",
    // Allow to fetch URLs in your app
    // see https://developers.cloudflare.com/workers/configuration/compatibility-flags/#global-fetch-strictly-public
    "global_fetch_strictly_public",
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "d1_databases": [
    {
      "binding": "D1",
      // TODO (per-client): run `pnpm wrangler d1 create <client>-cms` and paste the returned id here
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "database_name": "starter-cms",
      "remote": true,
    },
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      // TODO (per-client): match the worker name above
      "service": "starter-cms",
    },
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      // TODO (per-client): run `pnpm wrangler r2 bucket create <client>-media`
      "bucket_name": "starter-media",
    },
    // Create a R2 binding with the binding name "NEXT_INC_CACHE_R2_BUCKET"
    // {
    //   "binding": "NEXT_INC_CACHE_R2_BUCKET",
    //   "bucket_name": "<BUCKET_NAME>",
    // },
  ],

  // Here's how to configure an additional environment
  // It can be deployed with `CLOUDFLARE_ENV=staging pnpm run deploy`
  // "env": {
  //   "staging": {
  //     "name": "my-app-staging",
  //     "d1_databases": [
  //       {
  //         "binding": "D1",
  //         "database_id": "DATABASE_ID",
  //         "database_name": "my-app-staging",
  //         "remote": true
  //       }
  //     ],
  //     "services": [
  //       // The service should match the "name" of your worker
  //       // {
  //       //   "binding": "WORKER_SELF_REFERENCE",
  //       //   "service": "my-app-staging"
  //       // },
  //     ],
  //     "r2_buckets": [
  //       {
  //         "binding": "R2",
  //         "bucket_name": "my-app-staging"
  //       }
  //       // Create a R2 binding with the binding name "NEXT_INC_CACHE_R2_BUCKET"
  //       // {
  //       //   "binding": "NEXT_INC_CACHE_R2_BUCKET",
  //       //   "bucket_name": "<BUCKET_NAME>",
  //       // },
  //     ]
  //   }
  // }
}
